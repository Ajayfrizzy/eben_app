# Copy to apps/.env. Leave both blank for development-only demo mode.
# Release builds require your real public project URL and anon/publishable key.
# Never put service-role or other server secrets in the mobile environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
