# Copy to apps/.env. Leave both blank for development-only demo mode.
# Release builds require your real public project URL and anon/publishable key.
# Never put service-role or other server secrets in the mobile environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Approved legal documents only. Live signup stays blocked until configured.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_VERSION=
EXPO_PUBLIC_PRIVACY_VERSION=
EXPO_PUBLIC_TERMS_EFFECTIVE_DATE=
EXPO_PUBLIC_PRIVACY_EFFECTIVE_DATE=
# Set true only after organizational approval; keep false for public builds until then.
EXPO_PUBLIC_LEGAL_APPROVED=false
