{
  "expo": {
    "name": "Eben Institute",
    "slug": "eben-institute",
    "scheme": "eben",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.ebeninstitute.mobile",
      "adaptiveIcon": {
        "foregroundImage": "../assets/android/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0D5E27"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "../assets/android/splash.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c94a9c32-ed20-46bb-bd3c-51df5f32e7ca"
      }
    },
    "owner": "ajayfrizzys-team",
    "icon": "../assets/android/icon.png"
  }
}
