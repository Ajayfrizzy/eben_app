{
  "name": "eben-institute",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:mobile": "npm run start -w @eben/mobile",
    "dev:mobile:offline": "npm run start:offline -w @eben/mobile --",
    "dev:admin": "npm run dev -w @eben/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {"@types/react":"~19.1.10","ajv":"^8.20.0","prettier":"^3.3.3","typescript":"^5.9.2"}
}
