{
  "name": "eben-institute",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w @eben/mobile",
    "dev:mobile:offline": "npm run start:offline -w @eben/mobile --",
    "lint": "npm run lint -w @eben/mobile",
    "typecheck": "tsc --noEmit && npm run typecheck -w @eben/mobile",
    "test": "npm run test -w @eben/mobile",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "ajv": "^8.20.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@expo/metro-config": {
      "postcss": "^8.5.29"
    }
  }
}
